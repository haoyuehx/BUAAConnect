# BUAAConnect generic configuration template.
# Do not commit files containing credentials to version control.

# Profile-based defaults: "school" or "act". When set, the corresponding
# built-in server address, port, TUN name and proxy binds are used as defaults.
# profile = "school"

protocol = "easyconnect" # "easyconnect" or "atrust"
server_address = ""      # e.g. "vpn.buaa.edu.cn" or "vpn.act.buaa.edu.cn"
server_port = 443
username = ""
password = "" # Prefer BUAA_CONNECT_PASSWORD or interactive prompt; do not commit plaintext.

# TUN / routing
tun_mode = false
add_route = false
tun_name = "buaa-tun"
extra_routes = [] # e.g. ["10.212.0.0/16", "10.213.1.5"]

# System DNS integration (auto | resolvectl | off)
system_dns = "auto"

# Lifecycle
state_dir = ""
max_reconnect = 5
reconnect_delay = 3

# Proxy binds
socks_bind = ":1080"
socks_user = ""
socks_passwd = ""
http_bind = ":1081"
shadowsocks_url = "" # "ss://aes-128-gcm:password@:1082"
dial_direct_proxy = "" # "http://127.0.0.1:7890" or "socks://127.0.0.1:7890"

tcp_tunnel_mode = false
dns_ttl = 3600
disable_keep_alive = false
keep_alive_url = "" # e.g. "https://www.cnki.net/favicon.ico"
remote_dns_server = "auto"
secondary_dns_server = "auto"
dns_server_bind = ""
local_dns_server = "" # DNS used to resolve the VPN server hostname, e.g. "223.5.5.5"
dns_hijack = false
fake_ip = false
debug_dump = false
debug_pcap_file = "" # Reconstruct encrypted VPN underlay TCP traffic in this PCAP file (debug only)
debug_tls_log_file = "" # Export TLS session secrets in NSS key log format (debug only)
bind_interface = ""
auto_detect_interface = false

# ZJU compatibility is disabled by default to avoid accidentally connecting to
# ZJU servers. Only set disable_zju_config = false if you explicitly need it.
disable_zju_config = true

# Port forwarding and custom DNS
port_forwarding = [
#    { network_type = "tcp", bind_address = "127.0.0.1:9898", remote_address = "10.212.98.98:80" },
]

custom_dns = [
#    { host_name = "example.buaa.edu.cn", ip = "10.212.8.198"},
]

# EasyConnect specific settings
totp_secret = ""
cert_file = ""
cert_password = ""
disable_server_config = false
skip_domain_resource = false
disable_multi_line = false
proxy_all = false
custom_proxy_domain = [
#    "science.org",
#    "nature.com"
]
twf_id = ""

# aTrust specific settings
auth_type = "auth/psw"
login_domain = "Radius"
client_data_file = "client_data.json"
graph_code_file = "" # Optional: captcha image will open in browser if left empty.
cas_ticket = ""
oauth2_code = ""
phone = ""
update_best_nodes_interval = 300
session_refresh_interval = 1800 # aTrust authConfig refresh interval in seconds; 0 disables
sid = ""
device_id = ""
sign_key = ""
resource_file = ""
